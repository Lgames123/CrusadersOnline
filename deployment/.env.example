# Copy to deployment/.env (git-ignored) and fill in.
DB_PASSWORD=change_me_to_a_long_random_password

# Local HTTP testing: keep SITE_ADDRESS=:80 and COOKIE_SECURE=false.
# Production: SITE_ADDRESS=play.example.com (automatic TLS), COOKIE_SECURE=true, WEB_PORT=80, WEB_TLS_PORT=443.
SITE_ADDRESS=:80
COOKIE_SECURE=false
WEB_PORT=8088
WEB_TLS_PORT=8443
LOG_LEVEL=info

# World: ARENA=synthetic-arena, or an original level act (e.g. level:ca1a) converted from the
# operator's own copy with `pnpm convert` into GENERATED_DIR (relative to deployment/).
# ITEM_RULES=/app/local/generated/rules/items.json uses the full converted item table.
ARENA=synthetic-arena
GENERATED_DIR=../local/generated
ITEM_RULES=

# Backups (compose `backup` service): every BACKUP_INTERVAL_SECONDS into BACKUP_DIR
# (relative to deployment/), keeping BACKUP_KEEP_DAYS days. Copy BACKUP_DIR off the host too.
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=7

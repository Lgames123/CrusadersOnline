# Copy to deployment/.env (git-ignored) and fill in.
DB_PASSWORD=change_me_to_a_long_random_password

# Local HTTP testing: keep SITE_ADDRESS=:80 and COOKIE_SECURE=false.
# Production: SITE_ADDRESS=play.example.com (automatic TLS), COOKIE_SECURE=true, WEB_PORT=80, WEB_TLS_PORT=443.
SITE_ADDRESS=:80
COOKIE_SECURE=false
WEB_PORT=8088
WEB_TLS_PORT=8443
LOG_LEVEL=info

# Behind a Cloudflare Tunnel (deployment.md §6.2): COOKIE_SECURE=true, CLIENT_IP_HEADER=cf-connecting-ip,
# WEB_PORT=127.0.0.1:8088. A named tunnel (`--profile tunnel`) reads CLOUDFLARED_DIR (relative to
# deployment/, git-ignored): config.yml plus the credentials from `cloudflared tunnel create`.
CLIENT_IP_HEADER=x-forwarded-for
CLOUDFLARED_DIR=./cloudflared

# World: ARENA=synthetic-arena, or an original level act (e.g. level:ca1a) converted from the
# operator's own copy with `pnpm convert` into GENERATED_DIR (relative to deployment/).
# ITEM_RULES=/app/local/generated/rules/items.json uses the full converted item table.
ARENA=synthetic-arena
GENERATED_DIR=../local/generated
ITEM_RULES=

# Backups (compose `backup` service): every BACKUP_INTERVAL_SECONDS into BACKUP_DIR
# (relative to deployment/), keeping BACKUP_KEEP_DAYS days. Copy BACKUP_DIR off the host too.
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=7

# Off-host copies (`--profile offsite`): an rclone remote:path from RCLONE_CONFIG_DIR/rclone.conf
# (relative to deployment/, git-ignored), e.g. b2crypt:crusaders-backups for an encrypted bucket.
OFFSITE_REMOTE=
OFFSITE_INTERVAL_SECONDS=3600
OFFSITE_KEEP_DAYS=30
RCLONE_CONFIG_DIR=./rclone

# Accounts (usernames, comma-separated) given the admin panel; the realm's display name.
ADMIN_USERS=
REALM_NAME=

# Optional rules (shared features.ts), comma-separated: e.g. mmoItems,mmoDungeons,mmoCrafting.
GAME_FEATURES=

# GET /metrics on the server's port (compose network only); set to require a bearer token.
METRICS_TOKEN=

{
  "name": "crusadersonline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm --filter @crusaders/tests test",
    "test:unit": "pnpm --filter @crusaders/tests test:unit",
    "convert": "pnpm --filter @crusaders/converter convert",
    "dev:server": "pnpm --filter @crusaders/server dev",
    "dev:client": "pnpm --filter @crusaders/client dev",
    "start:server": "pnpm --filter @crusaders/server start",
    "stop:server": "pnpm --filter @crusaders/server stop",
    "build": "pnpm --filter @crusaders/client build",
    "test:integration": "pnpm --filter @crusaders/tests test:integration",
    "db:migrate": "pnpm --filter @crusaders/server db:migrate",
    "test:e2e": "pnpm --filter @crusaders/tests test:e2e",
    "admin": "pnpm --filter @crusaders/server admin"
  }
}

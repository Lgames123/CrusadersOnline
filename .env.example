# ==============================================================================
# CrusadersOnline - Environment Configuration Template
# ==============================================================================
# All paths and secrets defined here are machine-local and private.
# NEVER commit .env to version control.

# Server Configuration
SERVER_PORT=8090
SERVER_HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=debug

# Client Configuration
CLIENT_PORT=3000

# Database Configuration (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=crusaders_online
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_password_here
# Development default: embedded PostgreSQL (PGlite) persisted to ./local/pgdata — no server needed.
DATABASE_URL=pglite:local/pgdata
# Real PostgreSQL: Docker dev database (deployment/docker-compose.dev.yml) or native install
# (deployment/sql/create_dev_database.sql; native PostgreSQL 18 listens on 5433 on this workstation).
# DATABASE_URL=postgresql://crusaders:crusaders_dev@127.0.0.1:5434/crusaders_online
# DATABASE_URL=postgresql://crusaders:crusaders_dev@127.0.0.1:5433/crusaders_online

# Session & Security (ADR-008: opaque server-side sessions, single-use WS tickets)
SESSION_TTL_HOURS=168
WS_TICKET_TTL_SECONDS=30
COOKIE_SECURE=false   # true in production (HTTPS)

# Asset Pipeline & Local Game Files (Client/User Feeding Only)
# Point this to your own legally owned installation of the original game
GAME_INSTALL_DIR="./Crusaders of Might and Magic"
ASSET_LOCAL_INPUT_DIR="./local/original"
ASSET_EXTRACTED_DIR="./local/extracted"
ASSET_GENERATED_DIR="./local/generated"
ASSET_CLIENT_TARGET_DIR="./client/public/imported-assets"

# Asset Validation & Conversion Settings
ENABLE_SYNTHETIC_FALLBACK=true
STRICT_ASSET_CHECKSUM_VERIFY=true

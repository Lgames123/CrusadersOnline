{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@crusaders/client",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@crusaders/server",
        "dev"
      ],
      "port": 8090
    },
    {
      "name": "server-level",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@crusaders/server",
        "dev"
      ],
      "env": {
        "ARENA": "level:ca1a"
      },
      "port": 8090
    },
    {
      "name": "server-inn",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@crusaders/server",
        "dev"
      ],
      "env": {
        "ARENA": "level:cs1b-inn"
      },
      "port": 8090
    },
    {
      "name": "server-ws",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@crusaders/server",
        "dev"
      ],
      "env": {
        "ARENA": "level:ws1a"
      },
      "port": 8090
    },
    {
      "name": "server-town",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@crusaders/server",
        "dev"
      ],
      "env": {
        "ARENA": "level:cs1b"
      },
      "port": 8090
    },
    {
      "name": "server-du",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@crusaders/server",
        "dev"
      ],
      "env": {
        "ARENA": "level:du1a"
      },
      "port": 8090
    }
  ]
}
{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@crusaders/client",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "server",
      "runtimeExecutable": "pnpm",
